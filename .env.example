# Bot token from https://discord.com/developers/applications
BOT_TOKEN=your-bot-token-here

# Application (client) ID from the Discord Developer Portal
CLIENT_ID=your-client-id-here

# Optional: free Spotify app credentials for full Spotify playlists/albums
# Create a free app at https://developers.spotify.com (Dashboard > Create app)
# Without them, Spotify single tracks still work (resolved via YouTube)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Bot prefix for text commands (e.g. p!play, p!skip)
PREFIX=p!

# Volume 0-100
DEFAULT_VOLUME=60

# Whether bots can request music (set to false to restrict)
ALLOW_BOT_USERS=false

# Locale used in embeds: pt-BR or en
LOCALE=pt-BR
